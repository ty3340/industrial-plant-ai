# Copy to ".env" (repo root) and fill in your values. python-dotenv finds it by
# walking up the directory tree, so one root .env serves every subsystem.

# Required — the LLM provider key (agents use gpt-4.1 by default).
OPENAI_API_KEY=your_openai_api_key

# Optional model overrides (defaults shown).
# LLM_MODEL=openai:gpt-4.1
# EMBEDDING_MODEL=text-embedding-3-small

# OPC UA server. Defaults to the local simulator (data/simulator/opcua_server.py).
OPC_SERVER_URL=opc.tcp://localhost:26543/BatchPlantServer

# MCP server the equipment agent calls. Docker sets this to http://mcp:8000/mcp.
# BATCH_PLANT_MCP_URL=http://127.0.0.1:8000/mcp

# API query timeout in seconds (default 180).
# QUERY_TIMEOUT_S=180

# Recipe database. Defaults to <repo_root>/data/static_data/plant.db.
# PLANT_DB_PATH=C:/path/to/plant.db
