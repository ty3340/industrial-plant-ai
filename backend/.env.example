# Copy to ".env" (repo root) and fill in your values. python-dotenv finds it by
# walking up the directory tree, so one root .env serves every subsystem.

# Required — all three agents use OpenAI gpt-4o.
OPENAI_API_KEY=your_openai_api_key

# OPC UA server. Defaults to the local simulator (data/simulator/opcua_server.py).
OPC_SERVER_URL=opc.tcp://localhost:26543/BatchPlantServer

# Recipe database. Defaults to <repo_root>/data/static_data/plant.db.
# PLANT_DB_PATH=C:/path/to/plant.db
